# apps/api (API + worker)
DATABASE_URL=postgresql+psycopg://preflight:preflight@localhost:5432/preflight
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=rq                          # 운영: cloudtasks
GCP_PROJECT=
GCP_LOCATION=asia-northeast3
TASKS_QUEUE=media
WORKER_URL=
TASKS_SERVICE_ACCOUNT=
OBJECT_STORAGE_ENDPOINT=https://storage.googleapis.com
OBJECT_STORAGE_PUBLIC_ENDPOINT=          # 비우면 OBJECT_STORAGE_ENDPOINT 사용
OBJECT_STORAGE_BUCKET=media-preflight
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto
WEB_ORIGINS=https://<your-web>.vercel.app
MAX_UPLOAD_BYTES=2147483648
FILE_RETENTION_HOURS=24
SIGNED_URL_TTL_SECONDS=600
JOB_TIMEOUT_SECONDS=1800
# CLOVA_API_KEY=         # V3 only, server-side
# CLOVA_API_SECRET=      # V3 only, server-side

# apps/web (Vercel) — 공개되어도 되는 값만
NEXT_PUBLIC_API_URL=https://preflight-api-xxxx.a.run.app
NEXT_PUBLIC_GITHUB_URL=https://github.com/Jade-Legate/media-preflight
NEXT_PUBLIC_PORTFOLIO_PDF_URL=
